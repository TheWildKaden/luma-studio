<Window x:Class="YakuzaMovesetCreator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yakuza 0 Moveset Creator" Width="1300" Height="780" MinWidth="900" MinHeight="540" Background="#151816" Foreground="#F3F3EA">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Background" Value="#D6F08A"/><Setter Property="Foreground" Value="#1A2113"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="#242924"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4F594B"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#1E231F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#434B40"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="14,9"/></Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="YAKUZA 0 MOVESET CREATOR" FontSize="28" FontWeight="Bold" Foreground="#D6F08A"/>
      <TextBlock Text="Fighter command, combos, animation assets and mod packaging" Foreground="#B2B9AE" Margin="0,3,0,18"/>
      <WrapPanel Margin="0,0,0,15">
        <Button Content="New project" Command="{Binding NewCommand}"/>
        <Button Content="Open project" Command="{Binding OpenCommand}"/>
        <Button Content="Save project" Command="{Binding SaveCommand}"/>
        <Button Content="Load CFC" Command="{Binding LoadCfcCommand}"/>
        <Button Content="Export mod ZIP" Command="{Binding ExportCommand}"/>
        <Button Content="Undo" Command="{Binding UndoCommand}"/>
        <Button Content="Redo" Command="{Binding RedoCommand}"/>
      </WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="#40483E" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" Foreground="#C6D7AF" TextWrapping="Wrap"/>
    </Border>
    <TabControl Background="#1B201C" Foreground="#F3F3EA">
      <TabItem Header="Moveset editor">
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Movesets" FontSize="18" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Movesets}" SelectedItem="{Binding SelectedMoveset}" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Commands" FontSize="18" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5"><TextBlock Text="{Binding Name}" Width="180"/><TextBlock Text="{Binding Animation}" Foreground="#D6F08A"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Animation remap" FontSize="18"/><TextBlock Text="{Binding SelectedCommand.Name}" Margin="0,8"/><TextBlock Text="Animation ID"/><ComboBox ItemsSource="{Binding AnimationNames}" SelectedItem="{Binding SelectedAnimation}" IsEditable="True" Margin="0,5,0,14"/><Button Content="Apply animation" Command="{Binding ApplyMoveCommand}"/><TextBlock Text="Direct animation slots are editable. Other combat properties require a verified game format." TextWrapping="Wrap" Foreground="#AEB5A9" Margin="0,18,0,0"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Combo graph">
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas Width="1100" Height="800" Background="#202620" Name="GraphCanvas"/></ScrollViewer>
          <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Add a branch" FontSize="18"/><TextBlock Text="From command offset" Margin="0,15,0,0"/><TextBox Text="{Binding EdgeFrom, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="To command offset"/><TextBox Text="{Binding EdgeTo, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Label"/><TextBox Text="{Binding EdgeLabel, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add branch" Command="{Binding AddEdgeCommand}"/><TextBlock Text="Project branches visualize planned chains. CFC combat flow is preserved during export." TextWrapping="Wrap" Foreground="#AEB5A9" Margin="0,18,0,0"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Animation studio"><StackPanel Margin="18"><TextBlock Text="Headless Blender" FontSize="18"/><TextBlock Text="Source .blend, .glb, .gltf or .fbx file" Margin="0,14,0,0"/><TextBox Text="{Binding AnimationInput, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Output file"/><TextBox Text="{Binding AnimationOutput, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="Inspect skeleton and animations" Command="{Binding InspectAnimationCommand}"/><Button Content="Export GLB" Command="{Binding ExportGlbCommand}"/><Button Content="Save Blend" Command="{Binding SaveBlendCommand}"/></WrapPanel><TextBlock Text="GMT and GMD conversion depends on a configured compatible external add-on or converter." TextWrapping="Wrap" Foreground="#AEB5A9" Margin="0,15,0,0"/></StackPanel></TabItem>
      <TabItem Header="Heat actions"><StackPanel Margin="18"><TextBlock Text="Heat action references" FontSize="18"/><TextBlock Text="References and notes are stored in the project. Binary heat action editing requires a verified format." TextWrapping="Wrap" Foreground="#AEB5A9" Margin="0,8,0,15"/><ListBox ItemsSource="{Binding HeatActions}" DisplayMemberPath="Name" Height="180"/><TextBlock Text="Name"/><TextBox Text="{Binding HeatName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Asset path"/><TextBox Text="{Binding HeatPath, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add reference" Command="{Binding AddHeatCommand}" HorizontalAlignment="Left"/></StackPanel></TabItem>
      <TabItem Header="Dependencies"><StackPanel Margin="18"><TextBlock Text="External tool paths" FontSize="18"/><TextBlock Text="Blender executable"/><TextBox Text="{Binding Settings.Blender, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="FighterCommander executable"/><TextBox Text="{Binding Settings.FighterCommander, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="GMT Converter executable"/><TextBox Text="{Binding Settings.GmtConverter, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="GMT/GMD Blender add-on directory"/><TextBox Text="{Binding Settings.GmtGmdAddon, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/><Button Content="Check Blender" Command="{Binding CheckBlenderCommand}"/></WrapPanel><TextBlock Text="External game tools are configurable. Their commands and format support vary by release." TextWrapping="Wrap" Foreground="#AEB5A9" Margin="0,18,0,0"/></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
